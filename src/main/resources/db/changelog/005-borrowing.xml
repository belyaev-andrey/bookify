<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="005-borrowing" author="bookify">
        <createTable tableName="borrowing">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="book_id" type="UUID"/>
            <column name="requested_book_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="member_id" type="UUID">
                <constraints nullable="false"/>
            </column>
            <column name="borrow_date" type="TIMESTAMP"/>
            <column name="return_date" type="TIMESTAMP"/>
            <column name="status" type="VARCHAR(20)" defaultValue="PENDING">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addForeignKeyConstraint baseTableName="borrowing" baseColumnNames="book_id"
                                  constraintName="borrowing_book_id_fkey"
                                  referencedTableName="book" referencedColumnNames="id"/>
        <addForeignKeyConstraint baseTableName="borrowing" baseColumnNames="member_id"
                                  constraintName="borrowing_member_id_fkey"
                                  referencedTableName="member" referencedColumnNames="id"/>
    </changeSet>

</databaseChangeLog>
