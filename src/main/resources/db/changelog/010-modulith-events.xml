<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="010-modulith-events" author="bookify">
        <createTable tableName="event_publication">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="completion_attempts" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="completion_date" type="TIMESTAMP(6) WITH TIME ZONE"/>
            <column name="event_type" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="last_resubmission_date" type="TIMESTAMP(6) WITH TIME ZONE"/>
            <column name="listener_id" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="publication_date" type="TIMESTAMP(6) WITH TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="serialized_event" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(255)"/>
        </createTable>
        <!-- No native Liquibase change type covers CHECK constraints; this stays as raw SQL. -->
        <sql>
            ALTER TABLE event_publication
                ADD CONSTRAINT event_publication_status_check
                    CHECK ((status)::text = ANY
                           ((ARRAY ['PUBLISHED'::character varying, 'PROCESSING'::character varying, 'COMPLETED'::character varying, 'FAILED'::character varying, 'RESUBMITTED'::character varying])::text[]));
        </sql>

        <createTable tableName="event_publication_archive">
            <column name="id" type="UUID">
                <constraints primaryKey="true" nullable="false" primaryKeyName="pk_event_publication_archive"/>
            </column>
            <column name="publication_date" type="TIMESTAMP(6) WITHOUT TIME ZONE">
                <constraints nullable="false"/>
            </column>
            <column name="listener_id" type="VARCHAR">
                <constraints nullable="false"/>
            </column>
            <column name="serialized_event" type="VARCHAR">
                <constraints nullable="false"/>
            </column>
            <column name="event_type" type="VARCHAR">
                <constraints nullable="false"/>
            </column>
            <column name="completion_date" type="TIMESTAMP(6) WITHOUT TIME ZONE"/>
            <column name="last_resubmission_date" type="TIMESTAMP(6) WITHOUT TIME ZONE"/>
            <column name="completion_attempts" type="INTEGER">
                <constraints nullable="false"/>
            </column>
            <column name="status" type="VARCHAR(255)"/>
        </createTable>
    </changeSet>

</databaseChangeLog>
