        </insert>
    </changeSet>

    <changeSet id="test-001-supervisor-test-data" author="bookify">
        <comment>
            Test user holding the SUPERVISOR authority that MemberService.disableMember requires via
            @PreAuthorize - a role that isn't part of any HTTP-level rule in SecurityConfig, so a plain
            LIBRARIAN passes the HTTP matcher for PUT /api/members/** but is still denied at the method layer.
        </comment>
        <insert tableName="users">
            <column name="username" value="testsupervisor"/>
            <column name="password" value="$2a$10$YKyJ5KAYVg7lbwoIzvtXOOxe2VPEvat7IY4AkgQp2mPnZjZw6.58C"/>
            <column name="enabled" valueBoolean="true"/>
        </insert>
        <insert tableName="authorities">
            <column name="username" value="testsupervisor"/>
            <column name="authority" value="ROLE_LIBRARIAN"/>
        </insert>
        <insert tableName="authorities">
            <column name="username" value="testsupervisor"/>
            <column name="authority" value="ROLE_SUPERVISOR"/>
        </insert>
    </changeSet>

